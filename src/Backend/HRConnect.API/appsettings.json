{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "ConnectionStrings": {
    "DefaultConnection": "Server=(localdb)\\MSSQLLocalDB;Database=HRConnectDb;Trusted_Connection=True;MultipleActiveResultSets=true"
  },
  "Database": {
    "MigrateOnStartup": false
  },
  "DocumentStorage": {
    "RootPath": ""
  },
  "Cors": {
    "AllowedOrigins": [
      "http://localhost:5173",
      "http://127.0.0.1:5173"
    ]
  },
  "GoogleAuth": {
    "ClientId": ""
  },
  "PasswordReset": {
    "TokenLifetimeMinutes": 30,
    "FrontendBaseUrl": "http://localhost:5173",
    "SmtpHost": "",
    "SmtpPort": 587,
    "SmtpEnableSsl": true,
    "SmtpUsername": "",
    "SmtpPassword": "",
    "FromEmail": "",
    "FromName": "HRConnect"
  },
  "Jwt": {
    "Issuer": "HRConnect",
    "Audience": "HRConnect.Api",
    "SigningKey": "",
    "AccessTokenMinutes": 15,
    "RefreshTokenDays": 7,
    "RefreshTokenRetentionDays": 3,
    "RefreshTokenCleanupIntervalHours": 12
  },
  "AllowedHosts": "*"
}
